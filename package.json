{
  "name": "pug",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --config apps/demo/vite.config.ts",
    "test": "vitest run",
    "build": "tsc && vite build --config apps/demo/vite.config.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "server": "tsx apps/demo/server.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vitest": "^0.30.0"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
