{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@pug/reactivity": ["./packages/reactivity/src"],
      "@pug/composer": ["./packages/composer/src"],
      "@pug/layout": ["./packages/layout/src"],
      "@pug/renderer": ["./packages/renderer/src"],
      "@pug/event": ["./packages/event/src"],
      "@pug/theme": ["./packages/theme/src"],
      "@pug/components": ["./packages/components/src"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts"]
}