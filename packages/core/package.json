{
  "name": "@pug-canvas-ui/core",
  "version": "0.1.0",
  "description": "响应式核心 - Snapshot + Context 状态管理",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@pug-canvas-ui/types": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
