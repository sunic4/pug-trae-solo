{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@pug-canvas-ui/types": ["../types/src/index.ts"],
      "@pug-canvas-ui/types/*": ["../types/src/*"],
      "@pug-canvas-ui/core": ["../core/src/index.ts"],
      "@pug-canvas-ui/core/*": ["../core/src/*"],
      "@pug-canvas-ui/render": ["../render/src/index.ts"],
      "@pug-canvas-ui/render/*": ["../render/src/*"],
      "@pug-canvas-ui/layout": ["../layout/src/index.ts"],
      "@pug-canvas-ui/layout/*": ["../layout/src/*"],
      "@pug-canvas-ui/input": ["../input/src/index.ts"],
      "@pug-canvas-ui/input/*": ["../input/src/*"],
      "@pug-canvas-ui/animation": ["../animation/src/index.ts"],
      "@pug-canvas-ui/animation/*": ["../animation/src/*"],
      "@pug-canvas-ui/theme": ["../theme/src/index.ts"],
      "@pug-canvas-ui/theme/*": ["../theme/src/*"],
      "@pug-canvas-ui/components": ["../components/src/index.ts"],
      "@pug-canvas-ui/components/*": ["../components/src/*"],
      "@pug-canvas-ui/platform": ["../platform/src/index.ts"],
      "@pug-canvas-ui/platform/*": ["../platform/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/__tests__"]
}
