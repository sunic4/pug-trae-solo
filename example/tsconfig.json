{
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "noUncheckedIndexedAccess": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": [],
        "paths": {
            "@/*": [
                "../src/*"
            ]
        }
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "../src/**/__tests__/**",
        "../node_modules",
        "../dist"
    ]
}